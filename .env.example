# =============================================================
# Solari Backend — Variables de entorno
# Copia a .env y rellena los valores reales. NUNCA subas .env.
# =============================================================

# ── Aplicación ───────────────────────────────────────────────
APP_NAME=Solari
APP_ENV=local                      # local | staging | production
APP_DEBUG=true                     # false en producción
API_V1_PREFIX=/api/v1

# ── Base de datos (misma que usa el backend PHP) ─────────────
# Formato async con psycopg 3:
DATABASE_URL=postgresql+psycopg://postgres:admin@127.0.0.1:5432/voluntapp

# ── JWT (DEBE coincidir con el backend Laravel para coexistir) ─
# Copia EXACTAMENTE el JWT_SECRET del .env de Laravel.
JWT_SECRET=cambia-esto-por-el-mismo-secreto-de-laravel
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=60          # igual a jwt.ttl de Laravel
JWT_REFRESH_TTL_MINUTES=20160      # igual a jwt.refresh_ttl de Laravel
# Emisor: debe coincidir con el iss que valida Laravel.
JWT_ISSUER=http://localhost:8000/api/v1/auth/login
# Nombre de clase del modelo de usuario en Laravel (para el claim prv).
JWT_PROVIDER_MODEL=App\Models\Usuario

# ── CORS ─────────────────────────────────────────────────────
# Orígenes permitidos separados por coma. Vacío = ninguno extra.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=10/hour
RATE_LIMIT_FORGOT_PASSWORD=3/hour
RATE_LIMIT_RESET_PASSWORD=5/hour

# ── Correo (SMTP conmutable) ─────────────────────────────────
# MAIL_BACKEND: console (desarrollo, imprime en log) | smtp
MAIL_BACKEND=console
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=false
MAIL_FROM_ADDRESS=noreply@solari.co
MAIL_FROM_NAME=Solari
# URL base del frontend para construir enlaces de recuperación/verificación.
FRONTEND_RESET_URL=http://localhost:5173/reset-password
FRONTEND_VERIFY_URL=http://localhost:5173/verify-email

# ── Google OIDC (login con Google) ───────────────────────────
# Se obtienen en Google Cloud Console (OAuth 2.0 Client IDs).
# Deja vacío para desactivar el login con Google.
GOOGLE_CLIENT_ID=
# IDs de cliente aceptados (web, android, ios) separados por coma.
# Si está vacío se usa GOOGLE_CLIENT_ID.
GOOGLE_ALLOWED_AUDIENCES=

# ── Seguridad de contraseñas ─────────────────────────────────
PASSWORD_MIN_LENGTH=8
