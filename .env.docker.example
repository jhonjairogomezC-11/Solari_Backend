# =============================================================
# Solari — Variables para docker-compose.yml
# Copia a .env.docker y cambia los valores. NUNCA subas .env.docker.
# Lo leen los servicios `db` (POSTGRES_*) y `backend` (el resto).
# =============================================================

# ── PostgreSQL (servicio db; la base se llama voluntapp, fijada en docker-compose.yml) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esta-clave

# ── Aplicación ──
APP_NAME=Solari
APP_ENV=local
APP_DEBUG=false

# Host `db` = nombre del servicio en docker-compose. Usuario y clave iguales a POSTGRES_*.
DATABASE_URL=postgresql+psycopg://postgres:cambia-esta-clave@db:5432/voluntapp

# El backend no arranca si empieza por "cambia-esto". Usa el mismo secreto que Laravel
# si ambos backends conviven, o uno largo y aleatorio.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_MINUTES=20160

# Origen del frontend servido por el contenedor `frontend`.
CORS_ORIGINS=http://localhost:5173

# ── Correo ──
MAIL_BACKEND=console
FRONTEND_RESET_URL=http://localhost:5173/reset-password
FRONTEND_VERIFY_URL=http://localhost:5173/verify-email

# ── Google OIDC (vacío = desactivado) ──
GOOGLE_CLIENT_ID=

# ── Archivos ──
UPLOAD_MAX_MB=5
UPLOAD_PUBLIC_BASE=http://localhost:9000/uploads
